{
  "name": "extension",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/extension/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {},
      "configurations": {
        "development": {
          "outputPath": "dist/apps/extension-dev"
        },
        "production": {
          "outputPath": "dist/apps/extension-prod"
        }
      }
    },
    "zip": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "configurations": {
        "development": {
          "commands": [
            "cd dist/apps && zip -r extension-dev.zip extension-dev"
          ]
        },
        "production": {
          "commands": [
            "cd dist/apps && zip -r extension-prod.zip extension-prod"
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "build-and-zip": {
      "executor": "nx:run-commands",
      "configurations": {
        "development": {
          "commands": [
            "nx run extension:build:development",
            "nx run extension:zip:development"
          ]
        },
        "production": {
          "commands": [
            "nx run extension:build:production",
            "nx run extension:zip:production"
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "extension:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "extension:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "extension:build:production",
          "hmr": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/extension/**/*.{ts,tsx,js,jsx}"]
      }
    }
  },
  "tags": ["frontend", "extension"]
}
